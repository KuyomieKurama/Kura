# Set this to a PostgreSQL URL for a local development database.
DATABASE_URL=postgres://kura_dev:change-me@127.0.0.1:5432/kura_dev
PORT=3000
# false, true, or a comma-separated allow-list of trusted proxy addresses/CIDRs.
TRUST_PROXY=false
# Keep all four OIDC core variables unset for local-only mode. Secrets belong in the
# untracked runtime environment, never in this file.
# OIDC_ISSUER_URL=https://auth.example.com/application/o/kura/
# OIDC_CLIENT_ID=kura-client
# OIDC_CLIENT_SECRET=replace-in-runtime-environment
# OIDC_REDIRECT_URL=https://kura.example.com/api/v1/auth/oidc/callback
# OIDC_GROUP_CLAIM=downloader_groups
# OIDC_USER_GROUPS=downloader-users
# OIDC_ADMIN_GROUPS=downloader-admins
