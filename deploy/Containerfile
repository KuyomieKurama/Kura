FROM docker.io/library/node:22-trixie-slim AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY migrations ./migrations
RUN corepack enable && pnpm install --frozen-lockfile && pnpm -r build \
 && pnpm --filter @kura/api deploy --prod /production \
 && pnpm --filter @kura/worker deploy --prod /production-worker

FROM docker.io/library/node:22-trixie-slim
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080
RUN groupadd --system kura && useradd --system --gid kura --home-dir /app kura \
 && mkdir -p /var/lib/kura/staging /var/lib/kura/blobstore \
 && chown -R kura:kura /var/lib/kura
# One image, two processes: the API (default CMD) and the worker (`node apps/worker/dist/index.js`).
# Paths below /var/lib/kura are writable for the kura user; kura-deploy.sh mounts a volume on the blobstore
# directory when the filesystem backend is configured.
ENV KURA_WORK_DIR=/var/lib/kura/staging KURA_STORAGE_ROOT=/var/lib/kura/blobstore
COPY --from=build --chown=kura:kura /production ./apps/api
COPY --from=build --chown=kura:kura /production-worker ./apps/worker
COPY --from=build --chown=kura:kura /app/apps/web/dist ./apps/web/dist
COPY --from=build --chown=kura:kura /app/migrations ./migrations
# Version and git commit of this build (REQ-DL-007). deploy/kura-deploy.sh passes both as build arguments: the
# version from the root package.json, the commit from git. The API reports them in /api/v1/status and in the
# version view; without them (a build by hand) it falls back to "unbekannt". Declared here, not at the top:
# build arguments do not cross stages, and a late ARG does not invalidate the cache of the layers above it.
ARG KURA_VERSION=""
ARG KURA_COMMIT=""
ENV KURA_VERSION=$KURA_VERSION KURA_COMMIT=$KURA_COMMIT
USER kura
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/index.js"]
