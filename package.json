{
  "name": "kura",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "migrate": "pnpm --filter @kura/storage migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "pg": "8.23.1"
  }
}
